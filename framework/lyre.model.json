  // ============ 里拉琴参数模型 ============
  // 改数字 → 点"应用重建"，3D 即时重算；"保存到模型文件"会连注释一起回写
  // 所有长度单位 mm；outline 段除外（cm，源自实物测量）
  "meta": {
    "name": "lyre",        // 模型名
    "units": "mm",         // 本文件单位（只支持 mm）
    "version": 1           // schema 版本
  },
  "params": {
    "height": 240,         // ★ 琴体总高。240=适配 250 热床（比例 1:1.35）
    "thickness": 20.7,     // ★ 琴体厚度（共振箱深度）
    "wall": 3.2,            // ★ 腔体壁厚（≥3mm 保证强度；面板/背板/四壁通用）,
    "soundHole": {         // 圆音孔（开在面板上，连通共振腔）
      "y": 8.6,            //   预留
      "r": 18.5,           //   半径
      "cy": -56.5          //   圆心 Y（在共振腔中心）
    },
    "stringHoles": {
      "cy": -106,
      "r": 2.2,
      "n": 7,
      "gap": 11.4
    },
    "bridge": {            // 品条（琴码，架弦的实心条）
      "w": 81,             //   宽（横向）
      "d": 7.4,            //   厚
      "h": 6,              //   高（决定弦离开面板的高度）
      "y": -98,            //   中心 Y
      "z": 20.7            //   底部 Z（=琴体顶面）
    },
    "window": {            // 弦窗（上部椭圆镂空，减重+造型）
      "cx": 0,             //   椭圆心 X
      "cy": 46.9,          //   椭圆心 Y
      "rx": 34,            //   横半径
      "ry": 47.3,          //   纵半径
      "SAMPLE": 48         //   椭圆细分段数（渲染平滑度）
    },
    "pegs": {              // 调音柱（×n，立在顶部横梁）
      "n": 7,              //   ★ 数量（与弦数一致）
      "gap": 11.4,         //   间距（与 stringHoles.gap 同步）
      "r": 4,              //   柱身半径
      "headR": 6,          //   柱头半径（防弦滑脱）
      "h": 16,             //   柱高
      "headH": 5,          //   柱头高
      "y": 108             //   所在横排的 Y（顶部横梁上）
    },
    "pegHoles": {          // 调音柱穿孔（穿过琴体，柱插入用）
      "r": 2               //   孔半径（<柱身半径，弦绕柱后锚紧）
    },
    "strings": {           // 琴弦（仅显示，永不导出 STL）
      "r": 0.6             //   弦半径（视觉）
    },
    "cavity": {
      "cx": 0,
      "cy": -56.5,
      "r": 48
    }
  },
  "outline": {             // ★ 琴体侧面轮廓（cm 坐标贝塞尔链，与实物同源）
    "note": "Y 平移 -16.25 居中后 × K=height/32.5 缩放成 mm",
    "start": [
